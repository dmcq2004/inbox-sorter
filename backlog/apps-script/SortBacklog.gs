// ---------- matching ----------

function lower_(s) { return String(s || '').toLowerCase(); }

/** The sender the daily sort would classify by: the newest message not sent by Dom. */
function senderOf_(messages) {
  for (let i = messages.length - 1; i >= 0; i--) {
    const from = lower_(messages[i].getFrom());
    if (from.indexOf(DOM) === -1) return { from: from, subject: messages[i].getSubject() || '' };
  }
  return null;
}

function touchesSchool_(messages) {
  return messages.some(function (m) {
    const people = lower_([m.getFrom(), m.getTo(), m.getCc()].join(' '));
    return SCHOOL.some(function (s) { return people.indexOf(s) !== -1; });
  });
}

/** First rule (in file order) whose match is in the sender. */
function firstRule_(from) {
  for (let i = 0; i < RULES.length; i++) if (from.indexOf(lower_(RULES[i].match)) !== -1) return i;
  return -1;
}

function priorityFor_(rule, subject) {
  const subj = lower_(subject);
  const o = rule.override || {};
  for (const p in o) {
    if (o[p].some(function (w) { return subj.indexOf(lower_(w)) !== -1; })) return p;
  }
  return rule.priority;
}

/**
 * Decides what to do with each thread found by rule i's search. A thread is only handled by rule i if its
 * sender's first matching rule is i (so rule order works exactly as in the daily sort). Anything else is skipped.
 */
function classify_(threads, i) {
  const all = GmailApp.getMessagesForThreads(threads);
  const out = { apply: [], skippedSchool: 0, skippedOther: 0 };
  threads.forEach(function (t, k) {
    const msgs = all[k];
    if (touchesSchool_(msgs)) { out.skippedSchool++; return; }
    const s = senderOf_(msgs);
    if (!s || firstRule_(s.from) !== i) { out.skippedOther++; return; }
    const rule = RULES[i];
    const p = priorityFor_(rule, s.subject);
    // Backlog only (Dom, 2026-11-23): Action and NeedsDom are archived too when the newest message is over 6 months old.
    const stale = msgs[msgs.length - 1].getDate().getTime() < STALE_BEFORE;
    const archive = stale || ((rule.archive !== undefined && rule.archive !== null) ? rule.archive : (p === 'FYI' || p === 'Bulk'));
    out.apply.push({ thread: t, msgIds: msgs.map(function (m) { return m.getId(); }), priority: p, folder: rule.folder,
                     archive: archive, from: s.from, subject: s.subject });
  });
  return out;
}

function queryFor_(rule) { return UNSORTED + ' from:"' + rule.match.replace(/"/g, '') + '"'; }

// ---------- spreadsheet ----------

function book_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('SHEET_ID');
  if (id) { try { return SpreadsheetApp.openById(id); } catch (e) { /* deleted: make a new one */ } }
  const ss = SpreadsheetApp.create(SHEET_NAME);
  props.setProperty('SHEET_ID', ss.getId());
  return ss;
}

function tab_(name, header) {
  const ss = book_();
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(header);
    sh.setFrozenRows(1);
    const first = ss.getSheetByName('Sheet1');
    if (first && ss.getSheets().length > 1) ss.deleteSheet(first);
  }
  return sh;
}

function appendRows_(sh, rows) {
  if (rows.length) sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
}

// ---------- labels ----------

function labels_() {
  const cache = {};
  return function (name) {
    if (!cache[name]) {
      const l = GmailApp.getUserLabelByName(name);
      if (!l) throw new Error('Label "' + name + '" does not exist. Stopping: this script never creates labels.');
      cache[name] = l;
    }
    return cache[name];
  };
}

/** Label name -> Gmail API label id. Needs the Gmail API service (Services > Gmail API) switched on. */
function labelIds_() {
  const m = {};
  (Gmail.Users.Labels.list('me').labels || []).forEach(function (l) { m[l.name] = l.id; });
  return function (name) {
    if (!m[name]) throw new Error('Label "' + name + '" does not exist. Stopping: this script never creates labels.');
    return m[name];
  };
}

/** Changes up to 1,000 messages per Gmail API call: far faster than GmailApp's thread-by-thread calls. */
function modify_(ids, add, remove) {
  for (let k = 0; k < ids.length; k += 1000) {
    Gmail.Users.Messages.batchModify({ ids: ids.slice(k, k + 1000), addLabelIds: add, removeLabelIds: remove }, 'me');
  }
}

/** Ids of the threads matching the rule's search that already have its folder label (so undo leaves that label alone). */
function haveFolder_(rule) {
  const ids = {};
  if (!rule.folder) return ids;
  let s = 0, page;
  do {
    page = GmailApp.search(queryFor_(rule) + ' label:"' + rule.folder + '"', s, BATCH);
    page.forEach(function (t) { ids[t.getId()] = true; });
    s += BATCH;
  } while (page.length === BATCH);
  return ids;
}

// ---------- dry run ----------

function dryRun() {
  const start = Date.now();
  const props = PropertiesService.getScriptProperties();
  let i = Number(props.getProperty('DRY_RULE') || 0);
  const sh = tab_('Dry run', ['rule #', 'match', 'priority', 'folder', 'would label', 'would archive',
                              'by priority', 'skipped (other rule)', 'skipped (school)', 'samples (sender | subject)']);
  if (i === 0) {
    if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).clearContent();
    let old = 0, s = 0, page;
    do { page = GmailApp.search(OLD_TRIAGED, s, BATCH); old += page.length; s += BATCH; } while (page.length === BATCH);
    appendRows_(sh, [['-', 'already labelled FYI/Bulk, still in inbox', '', '', 0, old, '', '', '', 'archiveOldTriaged would archive these']]);
  }
  for (; i < RULES.length; i++) {
    if (Date.now() - start > TIME_LIMIT_MS) {
      props.setProperty('DRY_RULE', String(i));
      Logger.log('Not finished: stopped before rule %s of %s. Click Run again.', i + 1, RULES.length);
      return;
    }
    const rule = RULES[i];
    // A big rule can take more than one run, so its running totals are saved between runs.
    const saved = JSON.parse(props.getProperty('DRY_PARTIAL') || 'null');
    const st = (saved && saved.rule === i) ? saved
      : { rule: i, offset: 0, label: 0, archive: 0, other: 0, school: 0, byP: {}, samples: [] };
    let page;
    do {
      if (Date.now() - start > TIME_LIMIT_MS) {
        props.setProperty('DRY_RULE', String(i));
        props.setProperty('DRY_PARTIAL', JSON.stringify(st));
        Logger.log('Not finished: stopped in rule %s of %s (%s threads into it). Click Run again.', i + 1, RULES.length, st.offset);
        return;
      }
      page = GmailApp.search(queryFor_(rule), st.offset, BATCH);
      st.offset += page.length;
      if (!page.length) break;
      const c = classify_(page, i);
      st.other += c.skippedOther; st.school += c.skippedSchool;
      c.apply.forEach(function (a) {
        st.label++; if (a.archive) st.archive++;
        st.byP[a.priority] = (st.byP[a.priority] || 0) + 1;
        if (st.samples.length < 3 || (a.priority !== rule.priority && st.samples.length < 5)) {
          st.samples.push((a.from + ' | ' + a.subject).slice(0, 150));
        }
      });
    } while (page.length === BATCH);
    props.deleteProperty('DRY_PARTIAL');
    appendRows_(sh, [[i + 1, rule.match, rule.priority, rule.folder || '', st.label, st.archive,
                      Object.keys(st.byP).map(function (p) { return p + ' ' + st.byP[p]; }).join(', '),
                      st.other, st.school, st.samples.join('\n')]]);
  }
  props.deleteProperty('DRY_RULE');
  Logger.log('Done. Report: %s', book_().getUrl());
}

// ---------- live ----------

function runLive() {
  const start = Date.now();
  const props = PropertiesService.getScriptProperties();
  const labelId = labelIds_();
  const log = tab_('Undo log', ['when', 'threadId', 'rule #', 'sender', 'subject', 'labels added', 'archived']);
  let i = Number(props.getProperty('LIVE_RULE') || 0);
  let done = 0;
  const seen = {};   // if Gmail's search lags behind a label change, never handle a thread twice
  for (; i < RULES.length; i++) {
    const rule = RULES[i];
    const hadFolder = haveFolder_(rule);
    let skipped = 0, page;
    do {
      if (Date.now() - start > TIME_LIMIT_MS) {
        props.setProperty('LIVE_RULE', String(i));
        Logger.log('Not finished: %s threads sorted this run, stopped in rule %s of %s. Click Run again.', done, i + 1, RULES.length);
        return;
      }
      page = GmailApp.search(queryFor_(rule), skipped, BATCH);   // sorted threads drop out of the search
      if (!page.length) break;
      const fresh = page.filter(function (t) { return !seen[t.getId()]; });
      skipped += page.length - fresh.length;   // a repeat is passed over; a later Run picks up anything missed
      fresh.forEach(function (t) { seen[t.getId()] = true; });
      if (!fresh.length) continue;
      const c = classify_(fresh, i);
      skipped += c.skippedOther + c.skippedSchool;
      applyAll_(c.apply, labelId, hadFolder, log, i + 1);
      done += c.apply.length;
    } while (page.length === BATCH);
  }
  props.deleteProperty('LIVE_RULE');
  Logger.log('Done: %s threads sorted this run. Log: %s', done, book_().getUrl());
}

function applyAll_(items, labelId, hadFolder, log, ruleNo) {
  if (!items.length) return;
  const groups = {};   // same labels + same archive choice -> one batch call
  items.forEach(function (a) {
    const names = [PRIORITY_LABEL[a.priority]];
    // Only add (and log) the folder if the thread hasn't got it already, so undo never removes a label Dom had.
    if (a.folder && !hadFolder[a.thread.getId()]) names.push(a.folder);
    a.names = names;
    const key = names.join('|') + '#' + a.archive;
    (groups[key] = groups[key] || { names: names, archive: a.archive, ids: [] }).ids.push.apply(groups[key].ids, a.msgIds);
  });
  const now = new Date();
  // Log first, so a run cut off mid-batch never leaves changes out of the undo log.
  appendRows_(log, items.map(function (a) {
    return [now, a.thread.getId(), ruleNo, a.from, a.subject, a.names.join(', '), a.archive ? 'yes' : 'no'];
  }));
  for (const key in groups) {
    const g = groups[key];
    modify_(g.ids, g.names.map(labelId), g.archive ? ['INBOX', 'UNREAD'] : []);
  }
}

/**
 * Archives (and marks read) threads that already have a priority label but are still in the Inbox:
 * all old FYI/Bulk, and Action/NeedsDom over 6 months old (Dom, 2026-11-23). Labels are kept.
 */
function archiveOldTriaged() {
  const start = Date.now();
  const log = tab_('Undo log', ['when', 'threadId', 'rule #', 'sender', 'subject', 'labels added', 'archived']);
  let done = 0;
  const seen = {};
  const passes = [[OLD_TRIAGED, 'old-triaged'], [OLD_ACTION, 'old-action']];
  for (let k = 0; k < passes.length; k++) {
    while (true) {
      if (Date.now() - start > TIME_LIMIT_MS) { Logger.log('Not finished: %s threads archived this run. Click Run again.', done); return; }
      const msgs = (Gmail.Users.Messages.list('me', { q: passes[k][0], maxResults: 500 }).messages || [])
        .filter(function (m) { return !seen[m.id]; });
      if (!msgs.length) break;
      msgs.forEach(function (m) { seen[m.id] = true; });
      const threads = {};
      msgs.forEach(function (m) { threads[m.threadId] = true; });
      const now = new Date();
      // Log first, so a run cut off mid-batch never leaves changes out of the undo log.
      appendRows_(log, Object.keys(threads).map(function (id) { return [now, id, passes[k][1], '', '', '', 'yes']; }));
      modify_(msgs.map(function (m) { return m.id; }), [], ['INBOX', 'UNREAD']);
      done += Object.keys(threads).length;
    }
  }
  Logger.log('Done: %s threads archived this run.', done);
}

// ---------- sweep (after the rules) ----------

function schoolFolder_(messages) {
  const people = lower_(messages.map(function (m) { return [m.getFrom(), m.getTo(), m.getCc()].join(' '); }).join(' '));
  return people.indexOf('tyec@hotmail.com') !== -1 ? 'School/Young Explorers' : 'School/Trinity';
}

/** Pass 0: old school threads. Pass 1: old threads no rule matches. Each returns what to do, or null to leave it. */
const SWEEP_PASSES = [
  { name: 'old school mail', tag: 'sweep-school',
    query: function () {
      return UNSORTED + ' older_than:30d {' + SCHOOL.map(function (a) {
        const t = a.replace(/^@/, '');
        return 'from:' + t + ' to:' + t + ' cc:' + t;
      }).join(' ') + '}';
    },
    decide: function (msgs) {
      if (!touchesSchool_(msgs)) return null;
      if (msgs[msgs.length - 1].getDate().getTime() >= SCHOOL_BEFORE) return null;
      return { priority: 'FYI', folder: schoolFolder_(msgs) };
    } },
  { name: 'unruled mail over 1 year old', tag: 'sweep-old',
    query: function () { return UNSORTED + ' older_than:1y'; },
    decide: function (msgs) {
      if (touchesSchool_(msgs)) return null;
      if (msgs[msgs.length - 1].getDate().getTime() >= LEFTOVER_BEFORE) return null;   // a newer reply keeps it
      const s = senderOf_(msgs);
      if (s && firstRule_(s.from) > -1) return null;   // a rule handles it (runLive)
      return { priority: 'FYI', folder: null };
    } },
];

function sweepDryRun() { sweep_(false); }
function sweepLive() { sweep_(true); }

function sweep_(live) {
  const start = Date.now();
  const props = PropertiesService.getScriptProperties();
  const key = live ? 'SWEEP_LIVE' : 'SWEEP_DRY';
  const st = JSON.parse(props.getProperty(key) || 'null') || { pass: 0, offset: 0, counts: [0, 0], folders: {}, samples: [[], []] };
  const labelId = live ? labelIds_() : null;
  const log = live ? tab_('Undo log', ['when', 'threadId', 'rule #', 'sender', 'subject', 'labels added', 'archived']) : null;
  for (; st.pass < SWEEP_PASSES.length; st.pass++, st.offset = 0) {
    const pass = SWEEP_PASSES[st.pass];
    const hadFolder = {};
    let page;
    do {
      if (Date.now() - start > TIME_LIMIT_MS) {
        props.setProperty(key, JSON.stringify(st));
        Logger.log('Not finished: %s in %s so far. Click Run again.', st.counts[st.pass], pass.name);
        return;
      }
      // Live: handled threads drop out of the search, so the offset only counts the ones left alone.
      page = GmailApp.search(pass.query(), st.offset, BATCH);
      if (!page.length) break;
      const all = GmailApp.getMessagesForThreads(page);
      const items = [];
      page.forEach(function (t, k) {
        const d = pass.decide(all[k]);
        if (!d) { st.offset++; return; }
        if (!live) st.offset++;
        const s = senderOf_(all[k]) || { from: '(only Dom)', subject: all[k][0].getSubject() || '' };
        const folderLabel = d.folder ? GmailApp.getUserLabelByName(d.folder) : null;
        const has = folderLabel && t.getLabels().some(function (l) { return l.getName() === d.folder; });
        items.push({ thread: t, msgIds: all[k].map(function (m) { return m.getId(); }), priority: d.priority,
                     folder: has ? null : d.folder, archive: true, from: s.from, subject: s.subject });
        st.counts[st.pass]++;
        if (d.folder) st.folders[d.folder] = (st.folders[d.folder] || 0) + 1;
        if (st.samples[st.pass].length < 8) st.samples[st.pass].push((s.from + ' | ' + s.subject).slice(0, 120));
      });
      if (live) applyAll_(items, labelId, hadFolder, log, pass.tag);
      props.setProperty(key, JSON.stringify(st));
    } while (page.length === BATCH);
  }
  props.deleteProperty(key);
  if (!live) {
    const sh = tab_('Sweep dry run', ['pass', 'would label FYI and archive', 'folders', 'samples (sender | subject)']);
    appendRows_(sh, SWEEP_PASSES.map(function (p, i) {
      return [p.name, st.counts[i], i === 0 ? JSON.stringify(st.folders) : '', st.samples[i].join('\n')];
    }));
  }
  Logger.log('Done: %s old school threads, %s old unruled threads %s. %s', st.counts[0], st.counts[1],
             live ? 'labelled and archived' : 'would be labelled and archived', book_().getUrl());
}

// ---------- sender tally ----------

/**
 * Read-only. Lists who sent the old inbox threads that no rule matched, biggest senders first, in the
 * "Unruled senders" tab (moved to the front of the spreadsheet). Resumable like the others.
 */
function tallySenders() {
  // Uses the Gmail API service (its own, larger quota) rather than GmailApp, which hit its daily limit on 2026-11-23.
  const start = Date.now();
  const props = PropertiesService.getScriptProperties();
  const state = JSON.parse(props.getProperty('TALLY_STATE') || 'null') || { token: null, read: 0, started: false };
  const raw = tab_('Tally raw', ['threadId', 'sender', 'domain', 'subject', 'newest', 'has rule']);
  if (!state.started) {
    if (raw.getLastRow() > 1) raw.getRange(2, 1, raw.getLastRow() - 1, 6).clearContent();
    state.started = true;
  }
  while (true) {
    if (Date.now() - start > TIME_LIMIT_MS) {
      props.setProperty('TALLY_STATE', JSON.stringify(state));
      Logger.log('Not finished: %s threads read so far. Click Run again.', state.read);
      return;
    }
    const resp = withRetry_(function () {
      return Gmail.Users.Threads.list('me', { q: UNSORTED, maxResults: 100, pageToken: state.token || undefined });
    });
    const ids = (resp.threads || []).map(function (t) { return t.id; });
    appendRows_(raw, ids.map(function (id) {
      const t = withRetry_(function () {
        return Gmail.Users.Threads.get('me', id, { format: 'metadata', metadataHeaders: ['From', 'Subject'] });
      });
      const msgs = t.messages || [];
      let from = '', subject = '';
      for (let j = msgs.length - 1; j >= 0; j--) {   // newest message not sent by Dom, as in the daily sort
        const h = {};
        (msgs[j].payload.headers || []).forEach(function (x) { h[x.name.toLowerCase()] = x.value; });
        if (lower_(h.from).indexOf(DOM) === -1) { from = lower_(h.from); subject = h.subject || ''; break; }
      }
      const m = from.match(/[\w.+-]+@([\w-]+\.)+[\w-]+/);
      const addr = m ? m[0] : (from || '(only Dom)');
      const domain = addr.indexOf('@') > -1 ? addr.split('@')[1] : addr;
      const newest = msgs.length ? new Date(Number(msgs[msgs.length - 1].internalDate)) : '';
      return [id, addr, domain, subject.slice(0, 120), newest, from && firstRule_(from) > -1 ? 'yes' : ''];
    }));
    state.read += ids.length;
    state.token = resp.nextPageToken || null;
    props.setProperty('TALLY_STATE', JSON.stringify(state));   // saved every page, so an error loses nothing
    if (!state.token) break;
    Utilities.sleep(4000);   // Gmail allows ~15,000 quota units a minute; 100 thread reads cost ~1,000
  }
  props.deleteProperty('TALLY_STATE');
  summariseTally_(raw);
  Logger.log('Done: %s threads read. See the "Unruled senders" tab: %s', state.read, book_().getUrl());
}

/** Runs fn, waiting and retrying (up to 3 times) when Gmail says the per-minute quota is used up. */
function withRetry_(fn) {
  for (let a = 0; ; a++) {
    try { return fn(); } catch (e) {
      if (a >= 3 || String(e).indexOf('Quota exceeded') === -1) throw e;
      Utilities.sleep(20000);
    }
  }
}

function summariseTally_(raw) {
  const rows = raw.getLastRow() > 1 ? raw.getRange(2, 1, raw.getLastRow() - 1, 6).getValues() : [];
  const by = {};
  rows.forEach(function (r) {
    const d = by[r[2]] = by[r[2]] || { n: 0, addrs: {}, subjects: [], newest: r[4], ruled: 0 };
    d.n++;
    d.addrs[r[1]] = (d.addrs[r[1]] || 0) + 1;
    if (d.subjects.length < 3) d.subjects.push(r[3]);
    if (r[4] > d.newest) d.newest = r[4];
    if (r[5] === 'yes') d.ruled++;
  });
  const out = Object.keys(by).map(function (k) {
    const d = by[k];
    const addrs = Object.keys(d.addrs).sort(function (a, b) { return d.addrs[b] - d.addrs[a]; }).slice(0, 3)
      .map(function (a) { return a + ' (' + d.addrs[a] + ')'; }).join(', ');
    return [k, d.n, d.newest, d.ruled, addrs, d.subjects.join(' // ')];
  }).sort(function (a, b) { return b[1] - a[1]; });
  const ss = book_();
  let sh = ss.getSheetByName('Unruled senders');
  if (sh) ss.deleteSheet(sh);
  sh = ss.insertSheet('Unruled senders', 0);
  sh.appendRow(['domain', 'threads', 'newest', 'sender has a rule (skipped)', 'top addresses', 'sample subjects']);
  sh.setFrozenRows(1);
  if (out.length) sh.getRange(2, 1, out.length, 6).setValues(out);
}

// ---------- undo ----------

function undo() {
  const start = Date.now();
  const props = PropertiesService.getScriptProperties();
  const label = labels_();
  const sh = book_().getSheetByName('Undo log');
  if (!sh || sh.getLastRow() < 2) { Logger.log('Nothing to undo.'); return; }
  const rows = sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues();
  let r = Number(props.getProperty('UNDO_ROW') || 0);
  for (; r < rows.length; r++) {
    if (Date.now() - start > TIME_LIMIT_MS) {
      props.setProperty('UNDO_ROW', String(r));
      Logger.log('Not finished: undone %s of %s. Click Run again.', r, rows.length);
      return;
    }
    const t = GmailApp.getThreadById(String(rows[r][1]));
    if (!t) continue;
    String(rows[r][5]).split(', ').filter(String).forEach(function (n) { t.removeLabel(label(n)); });
    if (rows[r][6] === 'yes') t.moveToInbox();
  }
  props.deleteProperty('UNDO_ROW');
  Logger.log('Done: undid %s threads. Clear the Undo log tab before running live again.', rows.length);
}

function resetProgress() {
  const props = PropertiesService.getScriptProperties();
  ['DRY_RULE', 'DRY_PARTIAL', 'LIVE_RULE', 'UNDO_ROW', 'TALLY_OFFSET', 'TALLY_STATE'].forEach(function (k) { props.deleteProperty(k); });
  Logger.log('Progress cleared.');
}
